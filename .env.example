# Copy to .env and fill in. .env is gitignored.
# Only needed for LOCAL work (scripts, terraform, docker build) — the running
# container gets its secrets injected by Batch from the executionRoleArn +
# Secrets Manager (see hf_token_secret_arn in terraform.tfvars).

# AWS SSO / credentials
AWS_REGION=us-east-1
AWS_PROFILE=                          # e.g. AdministratorAccess-<account-id>; empty = default chain

# Hugging Face — needed to accept the Gemma license AND to seed the HF token
# secret. Get one at https://huggingface.co/settings/tokens (read scope).
HF_TOKEN=

# Pinecone — only needed if you're driving bulk-import from this repo.
PINECONE_API_KEY=
